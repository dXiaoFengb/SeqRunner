<Window x:Class="Runner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="顺序化软件执行工具 V3" Height="760" Width="1100" MinHeight="600" MinWidth="850" Closing="OnClosing">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
   <Button Content="新增" Click="Add" Padding="12,6"/><Button Content="删除" Click="Delete" Padding="12,6" Margin="5,0,0,0"/><Button Content="上移" Click="Up" Padding="12,6" Margin="5,0,0,0"/><Button Content="下移" Click="Down" Padding="12,6" Margin="5,0,0,0"/><Button Content="保存配置" Click="Save" Padding="12,6" Margin="14,0,0,0"/>
   <Button Content="启动队列" Click="Start" Padding="12,6" Margin="14,0,0,0"/><Button Content="停止" Click="Stop" Padding="12,6" Margin="5,0,0,0"/><Button Content="确认当前任务完成" Click="Confirm" Padding="12,6" Margin="5,0,0,0"/><Button Content="跳过并继续" Click="Continue" Padding="12,6" Margin="5,0,0,0"/><Button Content="确认中断已核实" Click="ResolveRecovery" Padding="12,6" Margin="5,0,0,0"/>
  </WrapPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="TaskList" DisplayMemberPath="Name" SelectionChanged="SelectionChanged"/>
   <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor">
    <TextBlock Text="任务名称"/><TextBox x:Name="TaskNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <TextBlock Text="程序完整路径"/><TextBox x:Name="ProgramInput" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <TextBlock Text="启动参数"/><TextBox x:Name="ArgumentsInput" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <TextBlock Text="工作目录（留空使用程序目录）"/><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <TextBlock Text="完成方式"/><ComboBox SelectedValue="{Binding Completion}" SelectedValuePath="Content" Margin="0,2,0,8"><ComboBoxItem Content="进程退出"/><ComboBoxItem Content="日志信号"/><ComboBoxItem Content="人工确认"/></ComboBox>
    <CheckBox x:Name="TrustCompletionInput" Content="完成后自动进行下一项" IsChecked="{Binding TrustCompletion}" Margin="0,0,0,4"/>
    <TextBlock TextWrapping="Wrap" Margin="22,0,0,8" Foreground="DimGray" Text="不确定时不要勾选。按程序退出或日志信号判断时，软件会暂停，等你检查后再决定。只有确认完成信号确实代表任务结束时才勾选；如果程序之后还会更新或重启，也不要勾选。"/>
    <TextBlock Text="日志来源（仅日志信号适用）"/><ComboBox SelectedValue="{Binding LogSource}" SelectedValuePath="Content" Margin="0,2,0,8"><ComboBoxItem Content="程序输出"/><ComboBoxItem Content="日志文件"/></ComboBox>
    <TextBlock Text="日志文件路径"/><TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <TextBlock Text="成功信号（区分大小写）"/><TextBox Text="{Binding SuccessText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
    <CheckBox Content="普通失败后继续下一项（证据冲突和结果不明始终暂停）" IsChecked="{Binding ContinueOnFailure}"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,10,0,10"><ComboBox x:Name="HistoryList" DockPanel.Dock="Top" SelectionChanged="HistoryChanged" Margin="0,0,0,4"/><TextBox x:Name="Events" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
  <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="退出软件" Click="Exit" Padding="12,6"/><StackPanel><TextBlock Text="“跳过并继续”会进入下一项，当前任务不会记为成功。" TextWrapping="Wrap"/><TextBlock Text="仅跟踪受管进程组；外部服务启动的程序及更新重启不能自动确认。" Foreground="DarkRed" TextWrapping="Wrap"/><TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></DockPanel>
 </Grid>
</Window>
