<Window x:Class="Runner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="顺序化软件执行工具 V3" Height="760" Width="1100" MinHeight="600" MinWidth="850" Closing="OnClosing" Background="#F3F6F8" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#173047"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#173047"/><Setter Property="Margin" Value="0,12,0,8"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#526578"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Background="#18354B" LastChildFill="False">
   <StackPanel DockPanel.Dock="Top" Margin="12,22,12,0">
    <TextBlock Text="顺序执行工具" FontSize="17" FontWeight="Bold" Foreground="White" Margin="3,0,0,4"/><TextBlock Text="任务与计划" Foreground="#BDCFDA" Margin="3,0,0,22"/>
    <Button x:Name="NavRun" Style="{StaticResource NavButton}" Content="运行" Tag="Run" Click="Navigate"/><Button x:Name="NavTasks" Style="{StaticResource NavButton}" Content="任务" Tag="Tasks" Click="Navigate"/><Button x:Name="NavPlans" Style="{StaticResource NavButton}" Content="计划" Tag="Plans" Click="Navigate"/><Button x:Name="NavHistory" Style="{StaticResource NavButton}" Content="历史" Tag="History" Click="Navigate"/><Button x:Name="NavHelp" Style="{StaticResource NavButton}" Content="帮助" Tag="Help" Click="Navigate"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Column="1" Margin="22,18,22,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#DCE5EC" BorderThickness="1" Padding="12,9" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="停止" Click="Stop" Padding="14,5" Margin="10,0,0,0"/><Button DockPanel.Dock="Right" Content="查看待核实事项" Click="ResolveRecovery" Padding="12,5" Margin="10,0,0,0"/><StackPanel><TextBlock Text="当前状态" Foreground="#526578" FontSize="11"/><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#173047"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="RunPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="运行" Style="{StaticResource Heading}"/><TextBlock Text="查看当前状态，控制队列及需要人工处理的事项。" Style="{StaticResource Hint}"/>
     <Border Background="White" BorderBrush="#DCE5EC" BorderThickness="1" Padding="18" Margin="0,10,0,0"><StackPanel><TextBlock Text="队列操作" Style="{StaticResource Section}"/><TextBlock Text="启动已保存的任务；运行时可停止，或按提示处理当前任务。" Style="{StaticResource Hint}"/><WrapPanel><Button Content="启动队列" Click="Start" Background="#CDE7E5"/><Button Content="停止" Click="Stop"/><Button Content="确认当前任务完成" Click="Confirm"/><Button Content="跳过并继续" Click="Continue"/></WrapPanel><TextBlock Text="程序及受管子进程退出后，可选择“跳过并继续”；当前任务不会记为成功。" Style="{StaticResource Hint}"/><Separator Margin="0,5,0,8"/><TextBlock Text="完成后操作" Style="{StaticResource Section}"/><Button Content="取消完成后操作" Click="CancelCompletion" HorizontalAlignment="Left"/><TextBlock Text="仅跟踪受管进程组；外部服务启动的程序及更新重启不能自动确认。" Style="{StaticResource Hint}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="TasksPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="任务" Style="{StaticResource Heading}"/><TextBlock Text="先选择程序，再设置完成方式；首次使用请先人工观察运行结果。" Style="{StaticResource Hint}"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,14,0"><WrapPanel DockPanel.Dock="Top"><Button Content="新增" Click="Add"/><Button Content="新增 MAA 任务" Click="AddMaa"/><Button Content="MAA 接入说明" Click="ShowMaaGuide"/><Button Content="删除" Click="Delete"/><Button Content="上移" Click="Up"/><Button Content="下移" Click="Down"/></WrapPanel><ListBox x:Name="TaskList" DisplayMemberPath="Name" SelectionChanged="SelectionChanged"/></DockPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="White" BorderBrush="#DCE5EC" BorderThickness="1" Padding="16"><StackPanel x:Name="Editor">
       <TextBlock Text="1. 选择程序" Style="{StaticResource Section}"/><TextBlock Text="任务名称"/><TextBox x:Name="TaskNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
       <TextBlock Text="程序完整路径"/><DockPanel Margin="0,2,0,8"><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseProgram" Margin="8,0,0,0"/><TextBox x:Name="ProgramInput" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
       <TextBlock Text="2. 设置完成方式" Style="{StaticResource Section}"/><TextBlock Text="进程退出：程序结束后判断退出码；日志信号：查找本次新增的成功文字；人工确认：由你检查后确认。" Style="{StaticResource Hint}"/>
       <ComboBox SelectedValue="{Binding Completion}" SelectedValuePath="Content" Margin="0,2,0,8"><ComboBoxItem Content="进程退出"/><ComboBoxItem Content="日志信号"/><ComboBoxItem Content="人工确认"/><ComboBoxItem Content="MAA日志"/></ComboBox>
       <TextBlock Text="MAA日志：填写下方日志文件路径，确认不共享后才能自动判定；仅支持 MAA 6.21.4 / 6.22.0 中文日志格式，真实业务仍待验证。日志无法证明每行来源，首次请人工观察。" Style="{StaticResource Hint}"/>
       <CheckBox x:Name="MaaExclusiveLogInput" Content="我确认该日志不被其他 MAA 实例共享" IsChecked="{Binding MaaExclusiveLog}" Margin="0,0,0,6"/>
       <CheckBox x:Name="MaaStartByRunnerInput" Content="由 V3 启动 MAA 任务（试验）" IsChecked="{Binding MaaStartByRunner}" Margin="0,0,0,4"/><TextBlock Text="仅适用于 MAA日志和 6.21.4 / 6.22.0。启用时，本次启动跳过 MAA 自动启动任务、模拟器、PC 客户端和自动连接；请先准备连接目标。窗口或按钮无法确认时会暂停。" Style="{StaticResource Hint}"/>
       <CheckBox x:Name="MaaCloseOnCompletionInput" Content="MAA 日志完成后请求正常关闭 MAA" IsChecked="{Binding MaaCloseOnCompletion}" Margin="0,0,0,4"/><TextBlock Text="仅适用于 MAA日志；关闭需窗口身份可核实。请求可能被拒绝或转入托盘，不会强制结束。" Style="{StaticResource Hint}"/>
       <CheckBox x:Name="TrustCompletionInput" Content="完成后自动进行下一项" IsChecked="{Binding TrustCompletion}" Margin="0,0,0,4"/><TextBlock Text="首次试运行时建议保持关闭；确认信号确实代表业务结束、且没有未跟踪的子进程或更新重启后再开启。" Style="{StaticResource Hint}"/>
       <Expander Header="日志文件与信号（日志信号或 MAA日志）" Margin="0,4,0,8"><StackPanel Margin="12,8,0,0"><TextBlock Text="日志来源"/><ComboBox SelectedValue="{Binding LogSource}" SelectedValuePath="Content" Margin="0,2,0,8"><ComboBoxItem Content="程序输出"/><ComboBoxItem Content="日志文件"/></ComboBox><TextBlock Text="日志文件路径（MAA日志请选择 gui.log）"/><TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/><TextBlock Text="成功信号（区分大小写）"/><TextBox Text="{Binding SuccessText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/><CheckBox Content="日志可能被多个实例共享（需要人工核实）" IsChecked="{Binding SharedLog}" Margin="0,0,0,6"/><TextBlock Text="共享日志无法可靠区分写入来源；请避免手动同时启动共用日志的实例。" Style="{StaticResource Hint}"/></StackPanel></Expander>
       <TextBlock Text="3. 运行设置" Style="{StaticResource Section}"/><TextBlock Text="不清楚时保持默认；首次运行请人工观察程序和可能的子进程，并核对实际业务结果。" Style="{StaticResource Hint}"/>
       <Expander Header="更新或重启线索（可选）" Margin="0,4,0,8"><StackPanel Margin="12,8,0,0"><TextBlock Text="每行填写一条提示文字，最多 32 条，每条不超过 256 个字符。" Style="{StaticResource Hint}"/><TextBox x:Name="UpdateMarkersInput" Text="{Binding UpdateMarkers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4"/><TextBlock Text="留空时只使用内置线索。线索只能辅助识别，未发现线索不代表没有更新或重启；发现后仍需人工核实。" Style="{StaticResource Hint}"/></StackPanel></Expander>
       <CheckBox x:Name="TrackUpdateRestartInput" Content="更新时显示受管进程跟踪状态（试验）" IsChecked="{Binding TrackUpdateRestart}" Margin="0,4,0,3"/><TextBlock Text="只识别和等待本轮受管进程组内可能的重启程序；候选不代表业务成功。出现子进程时即使没有更新线索也会要求核实；更新跟踪超过 5 分钟会提示。无法识别组外程序。" Style="{StaticResource Hint}"/>
       <Expander Header="参数、工作目录与超时" Margin="0,4,0,8"><StackPanel Margin="12,8,0,0"><TextBlock Text="启动参数"/><TextBox x:Name="ArgumentsInput" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/><TextBlock Text="工作目录（留空使用程序目录）"/><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/><TextBlock Text="最长运行时间（分钟，0 表示不限制）"/><TextBox x:Name="TimeoutInput" Text="{Binding TimeoutMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,2,0,8"/><TextBlock Text="参数按目标程序的说明填写；超时只停止后续推进，并提示人工处理。" Style="{StaticResource Hint}"/><CheckBox Content="普通失败后继续下一项（证据冲突和结果不明始终暂停）" IsChecked="{Binding ContinueOnFailure}"/></StackPanel></Expander>
      </StackPanel></Border><Button Content="保存配置" Click="Save" HorizontalAlignment="Left" Margin="0,12,0,8"/></StackPanel></ScrollViewer>
     </Grid></Grid>
    <StackPanel x:Name="PlansPage" Visibility="Collapsed"><TextBlock Text="计划" Style="{StaticResource Heading}"/><TextBlock Text="管理定时、启动运行、任务间隔及完成后操作。" Style="{StaticResource Hint}"/><Button Content="打开计划管理" Click="OpenPlans" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock Text="计划只使用已保存的任务配置；软件运行或驻留托盘时才会检查定时。" Style="{StaticResource Hint}"/></StackPanel>
    <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="历史" Style="{StaticResource Heading}"/><TextBlock Text="选择一条记录查看状态、完成依据和事件。" Style="{StaticResource Hint}"/></StackPanel><ComboBox Grid.Row="1" x:Name="HistoryList" DisplayMemberPath="Display" SelectionChanged="HistoryChanged" Margin="0,4,0,8"/><TextBox Grid.Row="2" x:Name="Events" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid>
    <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="帮助" Style="{StaticResource Heading}"/><TextBlock Text="首次接入程序" Style="{StaticResource Section}"/><TextBlock Text="1. 在“任务”中新增配置，选择程序并填写它需要的参数。&#10;2. 按实际情况选择完成方式；不确定时保持自动进入下一项关闭。&#10;3. 保存后在“运行”页面手动启动，观察程序、子进程和实际业务结果。&#10;4. 只有确认完成依据可靠后，才考虑自动推进或加入计划。" Style="{StaticResource Hint}"/><TextBlock Text="使用边界" Style="{StaticResource Section}"/><TextBlock Text="本工具只管理自己启动且能够追踪的进程；外部服务、共享日志和更新重启可能无法确认。遇到状态不明时请先核实。" Style="{StaticResource Hint}"/><Button Content="查看使用注意事项" Click="ShowNotice" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="退出软件" Click="Exit" Margin="8,0,0,0"/><TextBlock Text="关闭窗口会转入托盘；退出软件前请停止并等待受管程序结束。" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
  </Grid>
 </Grid>
</Window>
