<Window x:Class="Runner.PlanWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="定时计划" Width="1050" Height="740" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="0,0,12,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="计划列表" FontWeight="Bold"/><WrapPanel Margin="0,6"><Button Content="新建" Click="NewPlan"/><Button Content="删除" Click="DeletePlan" Margin="5,0"/><Button Content="上移" Click="PlanUp"/><Button Content="下移" Click="PlanDown" Margin="5,0"/></WrapPanel></StackPanel><ListBox x:Name="PlansList" SelectionChanged="SelectPlan"/></DockPanel>
  <DockPanel Grid.Column="1"><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock TextWrapping="Wrap" Text="仅运行已保存的计划；软件需保持运行或在托盘中。错过或忙碌的时间点将跳过并记录。"/><WrapPanel Margin="0,8"><Button Content="保存计划" Click="Save" Padding="12,5"/><Button Content="手动运行已保存计划" Click="RunPlan" Margin="8,0" Padding="12,5"/><Button Content="关闭" Click="CloseWindow" Padding="12,5"/></WrapPanel></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"><TextBlock Text="计划名称"/><TextBox x:Name="PlanName" TextChanged="NameChanged" Margin="0,2,0,6"/><CheckBox x:Name="Enabled" Content="启用定时运行" Click="EnabledChanged" Margin="0,0,0,12"/>
    <TextBlock Text="时间点：选择星期，输入 24 小时时间，例如 09:30" FontWeight="Bold"/><ListBox x:Name="SlotsList" Height="90" SelectionChanged="SelectSlot" Margin="0,5"/><WrapPanel><TextBox x:Name="SlotTime" Width="65" Text="09:00"/><CheckBox x:Name="SlotEnabled" Content="启用该时间点" IsChecked="True" Margin="8,0"/><StackPanel x:Name="SlotDays" Orientation="Horizontal"/></WrapPanel><WrapPanel Margin="0,5,0,12"><Button Content="添加时间点" Click="AddSlot"/><Button Content="应用到选中时间点" Click="UpdateSlot" Margin="5,0"/><Button Content="删除时间点" Click="DeleteSlot"/></WrapPanel>
    <TextBlock Text="任务：从已保存任务中选择，并为每项选择运行星期" FontWeight="Bold"/><ListBox x:Name="ItemsList" Height="100" SelectionChanged="SelectItem" Margin="0,5"/><WrapPanel><ComboBox x:Name="TaskChoices" Width="200" DisplayMemberPath="Name"/><StackPanel x:Name="ItemDays" Orientation="Horizontal" Margin="8,0"/></WrapPanel><WrapPanel Margin="0,5"><Button Content="添加任务" Click="AddItem"/><Button Content="应用选中任务星期" Click="UpdateItem" Margin="5,0"/><Button Content="移除任务" Click="DeleteItem"/><Button Content="上移任务" Click="ItemUp" Margin="5,0"/><Button Content="下移任务" Click="ItemDown"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
