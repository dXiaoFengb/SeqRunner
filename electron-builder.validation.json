{
  "appId": "local.sequential-task-runner",
  "productName": "顺序任务调度器",
  "files": [
    "frontend-dist/**",
    "electron/**",
    "package.json",
    "VERSION.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "win": {
    "target": [
      "portable"
    ],
    "artifactName": "${productName}-v${version}-portable.${ext}",
    "signAndEditExecutable": false
  }
}
