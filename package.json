{
  "name": "sequential-task-runner",
  "version": "0.1.0",
  "private": true,
  "description": "本地顺序任务调度器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k --success command-1 \"vite --host 127.0.0.1 --strictPort --config frontend/vite.config.ts\" \"cross-env NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:preview": "concurrently -k --success command-1 \"vite --host 127.0.0.1 --port %RUNNER_PREVIEW_PORT% --strictPort --config frontend/vite.config.ts\" \"cross-env NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost wait-on http://127.0.0.1:%RUNNER_PREVIEW_PORT% && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:%RUNNER_PREVIEW_PORT% electron .\"",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc -p frontend/tsconfig.json --noEmit",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "electron:health": "cross-env RUNNER_HEALTH_CHECK=1 electron .",
    "package:backend": "node scripts/packaging-rebuild-required.cjs",
    "package:win": "node scripts/packaging-rebuild-required.cjs",
    "package:backend:validation": "node scripts/packaging-rebuild-required.cjs",
    "package:validation:prepare": "node scripts/package-v2.cjs prepare",
    "validation:health": "node scripts/packaging-rebuild-required.cjs",
    "validation:finalize": "node scripts/package-v2.cjs finalize",
    "validate:audit-coverage": "node scripts/validate-audit-coverage.cjs",
    "package:validation": "node scripts/packaging-rebuild-required.cjs",
    "test:packaging": "node --test scripts/package-v2.test.cjs"
  },
  "devDependencies": {
    "@guolao/vue-monaco-editor": "1.6.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "37.2.5",
    "electron-builder": "26.0.12",
    "happy-dom": "18.0.1",
    "monaco-editor": "0.54.0",
    "typescript": "5.9.2",
    "vite": "7.0.4",
    "vitest": "4.1.9",
    "vue": "3.5.17",
    "vue-tsc": "2.2.12",
    "wait-on": "8.0.4"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "build": {
    "appId": "local.sequential-task-runner",
    "productName": "顺序任务调度器",
    "directories": {
      "output": "产物/工作"
    },
    "files": [
      "frontend/dist/**",
      "electron/**",
      "package.json",
      "VERSION.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "portable/backend/sequential-runner-backend.exe",
        "to": "backend/sequential-runner-backend.exe"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@lucide/vue": "1.58.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.1"
  }
}
