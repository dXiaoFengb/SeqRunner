{
  "name": "sequential-task-runner",
  "version": "0.1.0",
  "private": true,
  "description": "本地顺序任务调度器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort --config frontend/vite.config.ts\" \"cross-env NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc -p frontend/tsconfig.json --noEmit",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "electron:health": "cross-env RUNNER_HEALTH_CHECK=1 electron .",
    "package:backend": "backend\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --distpath portable\\backend --workpath build\\pyinstaller backend\\sequential_runner_backend.spec",
    "package:win": "npm run build && npm run package:backend && node scripts/package-portable.cjs",
    "package:backend:validation": "backend\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --distpath portable-validation-v022/backend --workpath build/pyinstaller-v022 backend\\sequential_runner_backend.spec",
    "package:validation": "npm run build && npm run package:backend:validation && node scripts/package-portable.cjs --validation"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "37.2.5",
    "happy-dom": "18.0.1",
    "typescript": "5.9.2",
    "vite": "7.0.4",
    "vitest": "4.1.9",
    "vue": "3.5.17",
    "vue-tsc": "2.2.12",
    "wait-on": "8.0.4"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "build": {
    "appId": "local.sequential-task-runner",
    "productName": "顺序任务调度器",
    "directories": { "output": "release" },
    "files": ["frontend-dist/**", "electron/**", "package.json", "VERSION.md"],
    "extraResources": [{ "from": "portable/backend/sequential-runner-backend.exe", "to": "backend/sequential-runner-backend.exe" }],
    "win": { "target": ["portable"], "artifactName": "${productName}-v${version}-portable.${ext}", "signAndEditExecutable": false }
  }
}
